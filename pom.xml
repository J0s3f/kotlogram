<?xml version="1.0" encoding="UTF-8"?>
<!--
  JitPack's "publish an existing jar" route needs a POM at the repository root to carry the
  coordinates. It is not the artifact's real POM - that one is generated by the Gradle publication and
  packaged inside the jar by CI. JitPack overwrites the groupId and artifactId with the
  repository-derived values anyway, so what matters here is that the file parses and names the project.

  See docs/publishing.md and jitpack.yml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.J0s3f</groupId>
    <artifactId>kotlogram</artifactId>
    <version>0.0.0-JITPACK-CARRIER</version>
    <packaging>pom</packaging>

    <name>kotlogramme</name>
    <description>
        Kotlin/JVM facade over Telegram's MTProto protocol, built on grammers, with the native libraries
        for every supported platform bundled into the published jar. This POM exists only so JitPack can
        install the pre-built jar; see jitpack.yml.
    </description>
    <url>https://github.com/J0s3f/kotlogram</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/J0s3f/kotlogram</url>
        <connection>scm:git:https://github.com/J0s3f/kotlogram.git</connection>
    </scm>
</project>
